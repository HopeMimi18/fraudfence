# For deployments set these explicitly and use HTTPS:
# FF_DATABASE_PATH=/secure/persistent/location/fraudfence.db
# FF_KEY_DIR=/secure/persistent/location/keys
# FF_SECURE_COOKIES=1
# FF_DEMO_MODE=0
# FF_ALLOWED_ORIGINS=https://your-domain.example

# CIPC: use EXACT token and lookup endpoints provided in YOUR APIVerse subscription.
# Do not guess endpoints, scrape BizPortal, or put these values in Git.
# FF_CIPC_TOKEN_URL=https://subscribed-host.example/oauth/token
# FF_CIPC_COMPANY_ENDPOINT=https://subscribed-host.example/companies/lookup
# FF_CIPC_ALLOWED_HOST=subscribed-host.example
# FF_CIPC_TOKEN_ALLOWED_HOST=oauth-host.example  # if different from API host
# FF_CIPC_CLIENT_ID=
# FF_CIPC_CLIENT_SECRET=
# FF_CIPC_SUBSCRIPTION_KEY=
# FF_CIPC_REG_PARAM=registrationNumber

# Ozow ONE API STAGING ONLY (never real funds). Credentials from Ozow support.
# FF_OZOW_CLIENT_ID=
# FF_OZOW_CLIENT_SECRET=
# FF_OZOW_SITE_CODE=
# FF_OZOW_RETURN_URL=https://public-https-tunnel.example/

# AI fraud report writer (fictional demo data ONLY; NEVER used for payment decisions)
# Offline local model: install Ollama on Windows and run: ollama pull llama3.2:3b
# FF_AI_PROVIDER=ollama
# FF_AI_MODEL=llama3.2:3b
# Or use separately billed API access (key supplied by environment/secret manager):
# FF_AI_PROVIDER=openai
# FF_AI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=SET_IN_TERMINAL_ONLY_NEVER_IN_GIT
# Leave FF_AI_PROVIDER unset for an honestly labelled rules-only report.
